# CampusConnect — Example Environment Variables
# This file is safe to commit. It shows what variables are needed.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
DATABASE_URL=postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres

# ─── Actual Email Delivery (Option 1: Resend) ──────────────────────
# Free 100 emails/day at https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=onboarding@resend.dev

# ─── Actual Email Delivery (Option 2: Gmail or Custom SMTP) ────────
# Free unlimited to any email using a Gmail App Password
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_app_password

NEXT_PUBLIC_APP_URL=https://campusconnect.vercel.app
NODE_ENV=production
DEV_EMAIL_BYPASS=false
DEV_OTP_PREVIEW=false

# ─── Vercel Blob Storage (for Lost & Found photos, uploads) ────────
# Get this from Vercel Project Dashboard -> Storage -> Blob
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxx_xxxxxxxxxxxxxxxx

