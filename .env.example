# CampusConnect — Example Environment Variables
# This file is safe to commit. It shows what variables are needed.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
DATABASE_URL=postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=noreply@campusconnect.app
NEXT_PUBLIC_APP_URL=https://campusconnect.vercel.app
NODE_ENV=production
DEV_EMAIL_BYPASS=false
DEV_OTP_PREVIEW=false
